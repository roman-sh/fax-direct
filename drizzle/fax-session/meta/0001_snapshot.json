      "checkConstraints": {
        "fax_session_singleton": {
          "name": "fax_session_singleton",
          "value": "\"fax_session\".\"id\" = 1"
        },
        "fax_session_document_status": {
          "name": "fax_session_document_status",
          "value": "\"fax_session\".\"document_status\" IS NULL OR \"fax_session\".\"document_status\" IN ('processing', 'ready', 'failed')"
        },
        "fax_session_document_error": {
          "name": "fax_session_document_error",
          "value": "\"fax_session\".\"document_error\" IS NULL OR \"fax_session\".\"document_error\" IN ('ENCRYPTED_PDF', 'EMPTY_PDF', 'FILE_TOO_LARGE', 'INVALID_FILE_TYPE', 'INVALID_PDF', 'TOO_MANY_PAGES', 'PROCESSING_FAILED')"
        },
        "fax_session_document_status_consistency": {
          "name": "fax_session_document_status_consistency",
          "value": "(\"fax_session\".\"document_status\" = 'failed' AND \"fax_session\".\"document_error\" IS NOT NULL) OR (\"fax_session\".\"document_status\" IS NULL OR \"fax_session\".\"document_status\" != 'failed') AND \"fax_session\".\"document_error\" IS NULL"
        },
        "fax_session_quote_currency": {
          "name": "fax_session_quote_currency",
          "value": "\"fax_session\".\"quote_currency\" IS NULL OR \"fax_session\".\"quote_currency\" = 'ILS'"
        },
        "fax_session_payment_status": {
          "name": "fax_session_payment_status",
          "value": "\"fax_session\".\"payment_status\" IS NULL OR \"fax_session\".\"payment_status\" IN ('initiated', 'pending', 'paid', 'failed')"
        },
        "fax_session_fax_status": {
          "name": "fax_session_fax_status",
          "value": "\"fax_session\".\"fax_status\" IS NULL OR \"fax_session\".\"fax_status\" IN ('preparing', 'queued', 'sending', 'finalizing', 'service_delayed', 'delivered', 'failed')"
        },
        "fax_session_fax_pages_sent": {
          "name": "fax_session_fax_pages_sent",
          "value": "\"fax_session\".\"fax_pages_sent\" IS NULL OR \"fax_session\".\"fax_pages_sent\" >= 0"
        },
        "fax_session_fax_pages_submitted": {
          "name": "fax_session_fax_pages_submitted",
          "value": "\"fax_session\".\"fax_pages_submitted\" IS NULL OR \"fax_session\".\"fax_pages_submitted\" >= 0"
        },
        "fax_session_fax_page_progress": {
          "name": "fax_session_fax_page_progress",
          "value": "\"fax_session\".\"fax_pages_sent\" IS NULL OR \"fax_session\".\"fax_pages_submitted\" IS NULL OR \"fax_session\".\"fax_pages_sent\" <= \"fax_session\".\"fax_pages_submitted\""
        },
        "fax_session_delivery_attempt": {
          "name": "fax_session_delivery_attempt",
          "value": "\"fax_session\".\"delivery_attempt\" >= 0"
        },
        "fax_session_fax_error": {
          "name": "fax_session_fax_error",
          "value": "\"fax_session\".\"fax_error\" IS NULL OR \"fax_session\".\"fax_error\" IN ('BUSY', 'CALL_REJECTED', 'CANCELED', 'CONNECTION_FAILED', 'DELIVERY_UNCONFIRMED', 'DESTINATION_UNAVAILABLE', 'DOCUMENT_PROCESSING_FAILED', 'FAX_INCOMPATIBLE', 'INVALID_NUMBER', 'NO_ANSWER', 'PARTIAL_TRANSMISSION', 'ROUTE_UNAVAILABLE', 'SERVICE_UNAVAILABLE', 'TRANSMISSION_INTERRUPTED', 'UNKNOWN_FAILURE', 'VOICE_ANSWERED')"
        }
