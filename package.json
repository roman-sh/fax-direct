    "next": "16.2.12",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
