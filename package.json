{
  "name": "fax-direct",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "config:seed": "tsx scripts/publish-market-config.ts --local",
    "config:publish": "tsx scripts/publish-market-config.ts --remote",
    "db:generate": "drizzle-kit generate",
    "db:d1:generate": "drizzle-kit generate --config=drizzle.d1.config.ts",
    "db:d1:migrate:local": "wrangler d1 migrations apply APP_DATABASE --local",
    "db:d1:migrate:remote": "wrangler d1 migrations apply APP_DATABASE --remote",
    "interfax:test": "node --env-file-if-exists=.dev.vars scripts/interfax-send.mjs",
    "logs:workflow": "wrangler workflows instances describe fax-delivery",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@opennextjs/cloudflare": "^1.19.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "currency.js": "^2.0.4",
    "drizzle-orm": "^0.45.2",
    "intl-messageformat": "^11.2.13",
    "iron-session": "^8.0.4",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "partysocket": "^1.3.0",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.4",
    "wrangler": "^4.120.0"
  }
}
